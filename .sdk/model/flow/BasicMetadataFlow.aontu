# BasicMetadataFlow

main: kit: flow: BasicMetadataFlow:
{
  entity: "metadata",
  kind: "basic",
  name: "BasicMetadataFlow",
  step: [
    {
      i: {
        ref: "metadata_ref01"
      }

      m: {
        database_id: "database01"
      }

      o: "create"
    }

    {
      m: {
        database_id: "database01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "metadata_ref01"
          }
        }
      ]
    }

    {
      d: {
        database_id: "database01"
      }

      i: {
        ref: "metadata_ref01",
        srcdatavar: "metadata_ref01_data",
        suffix: "_up0",
        textfield: "key"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-metadata_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "metadata_ref01",
        srcdatavar: "metadata_ref01_data",
        suffix: "_dt0"
      }

      m: {
        database_id: "database01",
        id: "metadata01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-metadata_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMetadataFlow"
}